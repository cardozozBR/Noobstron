APP_URL=https://app.example.com

APP_LOCALE=pt-BR
APP_FALLBACK_LOCALE=pt-BR
APP_TIMEZONE=UTC
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

POSTGRES_DB=nossa_plataforma
