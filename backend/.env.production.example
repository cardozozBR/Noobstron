POSTGRES_PASSWORD=bk2SGwjKTUjYh0c

APP_DB_USER=plataforma_app
APP_DB_PASSWORD=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nossa_plataforma
